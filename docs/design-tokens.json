{
  "$description": "SongLog — tokens de design. Cores validadas contra WCAG 2.2 (ver docs/etapa-2-ux-ui.md, seção 3). Importar no Figma como Variables (coleção Color, modos Claro / Escuro / Alto contraste).",
  "color": {
    "claro": {
      "bg":           { "$type": "color", "$value": "#F4F1EA", "$description": "Fundo de página (papel)" },
      "surface":      { "$type": "color", "$value": "#E9E4D8", "$description": "Faixas de tabela, linha selecionada, cabeçalhos" },
      "ink":          { "$type": "color", "$value": "#141414", "$description": "Texto principal, bordas de campo, foco" },
      "ink-2":        { "$type": "color", "$value": "#4A463E", "$description": "Texto secundário" },
      "mute":         { "$type": "color", "$value": "#645F55", "$description": "Metadados, dicas, placeholders" },
      "rule":         { "$type": "color", "$value": "#7F796D", "$description": "Bordas funcionais (>= 3:1)" },
      "rule-soft":    { "$type": "color", "$value": "#CFC9BA", "$description": "Separadores decorativos de linha (nunca sozinhos para indicar estado)" },
      "accent":       { "$type": "color", "$value": "#B92D19", "$description": "Notas e ação primária" },
      "accent-hover": { "$type": "color", "$value": "#951F0E", "$description": "Hover/pressed do acento" },
      "on-accent":    { "$type": "color", "$value": "#F4F1EA", "$description": "Texto sobre acento" },
      "disabled":     { "$type": "color", "$value": "#8C8678", "$description": "Texto desabilitado (isento de contraste; sempre acompanhado de rótulo claro)" }
    },
    "escuro": {
      "bg":           { "$type": "color", "$value": "#121110" },
      "surface":      { "$type": "color", "$value": "#1D1B18" },
      "ink":          { "$type": "color", "$value": "#F1EEE6" },
      "ink-2":        { "$type": "color", "$value": "#BDB7AA" },
      "mute":         { "$type": "color", "$value": "#9A9486" },
      "rule":         { "$type": "color", "$value": "#7D7869" },
      "rule-soft":    { "$type": "color", "$value": "#3A3833" },
      "accent":       { "$type": "color", "$value": "#FF7A5C" },
      "accent-hover": { "$type": "color", "$value": "#FF9478" },
      "on-accent":    { "$type": "color", "$value": "#121110" },
      "disabled":     { "$type": "color", "$value": "#6A665B" }
    },
    "alto-contraste": {
      "bg":           { "$type": "color", "$value": "#FFFFFF" },
      "surface":      { "$type": "color", "$value": "#F0F0F0" },
      "ink":          { "$type": "color", "$value": "#000000" },
      "ink-2":        { "$type": "color", "$value": "#1A1A1A" },
      "mute":         { "$type": "color", "$value": "#333333" },
      "rule":         { "$type": "color", "$value": "#000000" },
      "rule-soft":    { "$type": "color", "$value": "#767676" },
      "accent":       { "$type": "color", "$value": "#B00020" },
      "accent-hover": { "$type": "color", "$value": "#800016" },
      "on-accent":    { "$type": "color", "$value": "#FFFFFF" },
      "disabled":     { "$type": "color", "$value": "#595959" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "size": {
    "control-height":  { "$type": "dimension", "$value": "36px" },
    "row-height":      { "$type": "dimension", "$value": "44px" },
    "top-bar":         { "$type": "dimension", "$value": "56px" },
    "status-bar":      { "$type": "dimension", "$value": "32px" },
    "target-min":      { "$type": "dimension", "$value": "24px" },
    "rating-cell":     { "$type": "dimension", "$value": "24px" },
    "page-margin":     { "$type": "dimension", "$value": "40px" },
    "gutter":          { "$type": "dimension", "$value": "24px" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "strong":   { "$type": "dimension", "$value": "2px" },
    "focus":    { "$type": "dimension", "$value": "2px", "$description": "Anel de foco em ink, com 2px de folga na cor do fundo" },
    "radius":   { "$type": "dimension", "$value": "0px" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Source Serif 4" },
      "ui":      { "$type": "fontFamily", "$value": "Inter" },
      "mono":    { "$type": "fontFamily", "$value": "JetBrains Mono" }
    },
    "style": {
      "display":   { "family": "display", "weight": 600, "size": 72, "lineHeight": 72 },
      "h1":        { "family": "display", "weight": 600, "size": 40, "lineHeight": 44 },
      "h2":        { "family": "display", "weight": 600, "size": 24, "lineHeight": 32 },
      "label":     { "family": "ui",      "weight": 600, "size": 12, "lineHeight": 16, "letterSpacing": "0.06em", "textCase": "upper" },
      "body":      { "family": "ui",      "weight": 400, "size": 14, "lineHeight": 20 },
      "body-bold": { "family": "ui",      "weight": 600, "size": 14, "lineHeight": 20 },
      "small":     { "family": "ui",      "weight": 400, "size": 13, "lineHeight": 18 },
      "mono":      { "family": "mono",    "weight": 500, "size": 14, "lineHeight": 20 },
      "mono-lg":   { "family": "mono",    "weight": 500, "size": 20, "lineHeight": 28 }
    }
  }
}
